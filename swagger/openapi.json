{
  "openapi": "3.0.3",
  "info": {
    "title": "Apocalipse Zumbi API (Fano)",
    "version": "1.0.0",
    "description": "API REST para sobreviventes, inventários e relatórios do apocalipse zumbi."
  },
  "paths": {
    "/api/sobreviventes": {
      "get": {
        "tags": ["Sobreviventes"],
        "summary": "Lista todos os sobreviventes",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": ["Sobreviventes"],
        "summary": "Cria sobrevivente e inventário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {"type": "string"},
                  "idade": {"type": "integer"},
                  "sexo": {"type": "string", "enum": ["M", "F", "O"]},
                  "latitude": {"type": "number"},
                  "longitude": {"type": "number"},
                  "zumbi": {"type": "boolean"},
                  "id_recurso": {"type": "array", "items": {"type": "integer"}},
                  "quantidade": {"type": "array", "items": {"type": "integer"}}
                },
                "required": ["nome", "idade", "sexo", "latitude", "longitude", "zumbi"]
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Criado"},
          "422": {"description": "Dados inválidos"}
        }
      }
    },
    "/api/sobreviventes/{id}": {
      "get": {
        "tags": ["Sobreviventes"],
        "summary": "Mostra um sobrevivente",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {"200": {"description": "OK"}, "404": {"description": "Não encontrado"}}
      },
      "put": {
        "tags": ["Sobreviventes"],
        "summary": "Atualiza sobrevivente",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {"200": {"description": "OK"}, "422": {"description": "Zumbi ou inválido"}}
      },
      "patch": {
        "tags": ["Sobreviventes"],
        "summary": "Atualiza sobrevivente",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {"200": {"description": "OK"}, "422": {"description": "Zumbi ou inválido"}}
      },
      "delete": {
        "tags": ["Sobreviventes"],
        "summary": "Remove sobrevivente e inventário",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/api/informar-zumbificacao": {
      "post": {
        "tags": ["Zumbificacao"],
        "summary": "Registra aviso de contaminação",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_informante": {"type": "integer"},
                  "id_sobrevivente": {"type": "integer"}
                },
                "required": ["id_informante", "id_sobrevivente"]
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Aviso registrado"},
          "409": {"description": "Duplicado/contaminado"},
          "422": {"description": "Informante zumbi"}
        }
      }
    },
    "/api/inventario": {
      "get": {
        "tags": ["Inventario"],
        "summary": "Lista sobreviventes não zumbis com recursos",
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/api/inventario/{id}": {
      "get": {
        "tags": ["Inventario"],
        "summary": "Inventário de um sobrevivente não zumbi",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {"200": {"description": "OK"}, "404": {"description": "Não encontrado"}}
      }
    },
    "/api/inventario/troca": {
      "post": {
        "tags": ["Inventario"],
        "summary": "Troca recursos entre dois sobreviventes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_sobrevivente": {
                    "type": "array",
                    "items": {"type": "integer"},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "recursos_troca": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id_recurso": {"type": "integer"},
                          "quantidade": {"type": "integer"}
                        },
                        "required": ["id_recurso", "quantidade"]
                      }
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": ["id_sobrevivente", "recursos_troca"]
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Troca efetuada"},
          "422": {"description": "Pontuação/estoque inválidos"},
          "500": {"description": "Erro interno"}
        }
      }
    },
    "/api/relatorio-geral": {
      "get": {
        "tags": ["Relatorios"],
        "summary": "Resumo de infectados e recursos",
        "responses": {"200": {"description": "OK"}}
      }
    }
  }
}
